use App\Domain\UserManagement\Models\User;

final class {{ entity }}Policy
{
    public function viewAny(User $actor): bool
    {
        return $actor->can('view_{{ permissions }}');
    }

    public function view(User $actor, {{ entity }} ${{ variable }}): bool
    {
        return $actor->can('view_{{ permissions }}');
    }

